<Window x:Class="TrophyPop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrophyPop · Configurações" Width="600" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" ThemeMode="Dark"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="28,22,28,24">
        <TextBlock Text="Conta Steam" FontSize="20" FontWeight="SemiBold"/>

        <TextBlock Margin="0,14,0,6" Text="Chave da API Web da Steam"/>
        <TextBox x:Name="ApiKeyBox"/>
        <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap">
            Crie a sua de graça em
            <Hyperlink NavigateUri="https://steamcommunity.com/dev/apikey" RequestNavigate="Link_RequestNavigate">steamcommunity.com/dev/apikey</Hyperlink>.
            No campo de domínio pode colocar qualquer nome, como "localhost".
        </TextBlock>

        <TextBlock Margin="0,14,0,6" Text="SteamID ou link do seu perfil (opcional)"/>
        <TextBox x:Name="SteamIdBox"/>
        <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                   Text="Vazio = usa a conta logada na Steam deste PC. Seu perfil precisa mostrar os jogos: Steam › Perfil › Editar perfil › Privacidade › Detalhes de jogos: Público."/>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="TestButton" Content="Testar conexão" Click="Test_Click"/>
            <TextBlock x:Name="TestResult" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/>
        </StackPanel>

        <TextBlock Text="Troféus" FontSize="20" FontWeight="SemiBold" Margin="0,28,0,0"/>
        <TextBlock Margin="0,6,0,12" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                   Text="A Steam não tem bronze, prata e ouro. Aqui o tipo vem da raridade: quanto menos jogadores têm a conquista, mais valioso o troféu. Ao completar 100% do jogo você ganha a platina."/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Prata quando menos de" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="SilverBox" Grid.Column="1"/>
            <TextBlock Grid.Column="2" Text="% dos jogadores têm" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock Grid.Row="1" Text="Ouro quando menos de" VerticalAlignment="Center" Margin="0,8,10,0"/>
            <TextBox x:Name="GoldBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="% dos jogadores têm" VerticalAlignment="Center" Margin="10,8,0,0"/>
        </Grid>

        <TextBlock Margin="0,14,0,6" Text="Idioma dos nomes dos troféus"/>
        <ComboBox x:Name="LanguageBox" Width="280" HorizontalAlignment="Left"/>

        <TextBlock Text="Pop-up" FontSize="20" FontWeight="SemiBold" Margin="0,28,0,0"/>
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Posição na tela" Margin="0,0,0,6"/>
                <ComboBox x:Name="CornerBox" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="DurationLabel" Margin="0,0,0,6"/>
                <Slider x:Name="DurationSlider" Minimum="3" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="DurationSlider_ValueChanged"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SoundCheck" Content="Tocar som" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center"
                    IsEnabled="{Binding IsChecked, ElementName=SoundCheck}"/>
        </Grid>
        <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap">
            Quer seu próprio som? Coloque arquivos trofeu.wav e platina.wav na
            <Hyperlink Click="OpenFolder_Click">pasta do TrophyPop</Hyperlink>.
        </TextBlock>

        <CheckBox x:Name="StartupCheck" Content="Iniciar junto com o Windows" Margin="0,16,0,0"/>

        <DockPanel Margin="0,26,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Testar pop-up" Click="Preview_Click"/>
            <Button DockPanel.Dock="Right" Content="Salvar" Width="110" Margin="8,0,0,0" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" Click="Save_Click"/>
            <Button DockPanel.Dock="Right" Content="Cancelar" Width="110" IsCancel="True"/>
        </DockPanel>
    </StackPanel>
</Window>
