<UserControl x:Class="TrophyPop.TrophyIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False">
    <Viewbox Stretch="Uniform">
        <!-- tudo desenhado numa caixa 24x24 -->
        <Canvas Width="24" Height="24">
            <Ellipse x:Name="Glow" Canvas.Left="-8" Canvas.Top="-8" Width="40" Height="40" Opacity="0"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="GlowScale"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <Canvas x:Name="Cup" Width="24" Height="24" RenderTransformOrigin="0.5,0.9">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CupScale"/>
                        <RotateTransform x:Name="CupTilt"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Path x:Name="Body"/>
                <!-- luz à esquerda e sombra à direita dão o volume de metal -->
                <Path x:Name="Shade"/>
                <Rectangle Canvas.Left="6.9" Canvas.Top="2.75" Width="10.2" Height="0.7" RadiusX="0.35" RadiusY="0.35" Fill="#A0FFFFFF"/>
                <Canvas x:Name="GlintHost" Width="24" Height="24">
                    <Rectangle x:Name="Glint" Width="4.5" Height="36" Canvas.Top="-6">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#E6FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="22"/>
                                <TranslateTransform x:Name="GlintMove" X="-10"/>
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
            </Canvas>

            <Canvas x:Name="Sparks"/>
        </Canvas>
    </Viewbox>
</UserControl>
