<Window x:Class="TrophyPop.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrophyPop"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        Left="-10000" Top="-10000" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid x:Name="Root" Margin="20">
        <Grid x:Name="Shell" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Pop"/>
            </Grid.RenderTransform>

            <!-- sombra feita com camadas translúcidas: bem mais leve que um efeito de desfoque -->
            <Grid x:Name="ShadowBox" HorizontalAlignment="Left">
                <Border Margin="-3,2,-3,-6" CornerRadius="17" Background="#0C000000"/>
                <Border Margin="-1,1,-1,-3" CornerRadius="15" Background="#16000000"/>
            </Grid>

            <Border x:Name="Card" Width="392" CornerRadius="14" Padding="12"
                    Background="#F4222327" BorderBrush="#26FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="Art" Width="64" Height="64" CornerRadius="9">
                        <local:TrophyIcon x:Name="BigTrophy" Width="44" Height="44" Visibility="Collapsed"/>
                    </Border>

                    <!-- selo com a taça no canto da imagem da conquista -->
                    <Border x:Name="Badge" Width="28" Height="28" CornerRadius="14" Margin="0,0,-7,-7"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"
                            Background="#F0222327" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <local:TrophyIcon x:Name="BadgeTrophy" Width="19" Height="19"/>
                    </Border>

                    <StackPanel x:Name="TextPanel" Grid.Column="1" Margin="14,0,4,0" VerticalAlignment="Center" Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="TextShift"/>
                        </StackPanel.RenderTransform>
                        <StackPanel Orientation="Horizontal">
                            <local:TrophyIcon x:Name="HeaderTrophy" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HeaderText" Margin="6,0,0,0" FontSize="12.5" Foreground="#C8FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TitleText" Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="DetailText" Margin="0,3,0,0" FontSize="12" Foreground="#8CFFFFFF"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- brilho que atravessa o cartão (só na platina) -->
            <Canvas x:Name="SheenHost" IsHitTestVisible="False" Visibility="Collapsed">
                <Rectangle x:Name="Sheen" Width="90" Height="170" Canvas.Top="-40">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <SkewTransform AngleX="-22"/>
                            <TranslateTransform x:Name="SheenMove" X="-200"/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>
        </Grid>
    </Grid>
</Window>
