<Window x:Class="TrophyPop.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrophyPop · Estúdio" Width="1200" Height="800" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" ThemeMode="Dark"
        Background="#0B0F1A" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Background="#0B0F1A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- opções -->
        <TabControl x:Name="Tabs" Margin="14,14,8,0">
            <TabItem Header="Fundo">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LookPanel" Margin="6,6,18,18"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Animação">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MotionPanel" Margin="6,6,18,18"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Som">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SoundPanel" Margin="6,6,18,18"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Texto e posição">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TextPanel" Margin="6,6,18,18"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- prévia -->
        <Grid Grid.Column="1" Margin="8,14,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border CornerRadius="12" ClipToBounds="True" BorderBrush="#22FFFFFF" BorderThickness="1">
                <Grid>
                    <!-- uma "cena de jogo" simples atrás do pop-up, para ver o contraste -->
                    <Viewbox Stretch="UniformToFill">
                        <Canvas Width="1000" Height="600">
                            <Rectangle x:Name="Sky" Width="1000" Height="600"/>
                            <Ellipse x:Name="Sun" Canvas.Left="620" Canvas.Top="250" Width="190" Height="190"/>
                            <Path x:Name="FarHills" Data="M0,420 C150,340 300,385 450,350 C600,315 760,395 1000,335 L1000,600 L0,600 Z"/>
                            <Path x:Name="NearHills" Data="M0,505 C200,430 380,485 560,452 C740,420 860,482 1000,450 L1000,600 L0,600 Z"/>
                        </Canvas>
                    </Viewbox>
                    <Grid x:Name="StageHost" Margin="8"/>
                    <TextBlock Text="Prévia" Margin="16,12,0,0" Opacity="0.55" FontSize="12"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="0,0,0,12"/>
                </Grid>
            </Border>
            <WrapPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center">
                <TextBlock Text="Troféu" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8"/>
                <ComboBox x:Name="PreviewGrade" Width="120" Margin="0,0,12,0" SelectionChanged="Preview_Changed"/>
                <CheckBox x:Name="PreviewImage" Content="Com imagem da conquista" IsChecked="True" Margin="0,0,12,0"
                          VerticalAlignment="Center" Click="Preview_Changed"/>
                <ComboBox x:Name="SceneBox" Width="150" Margin="0,0,12,0" SelectionChanged="Scene_Changed"/>
                <Button Content="▶  Repetir com som" Margin="0,0,8,0" Click="Replay_Click"/>
                <Button Content="Testar na tela" Click="Screen_Click"/>
            </WrapPanel>
        </Grid>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="14,12,14,14" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Restaurar padrão" Click="Reset_Click"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center" Opacity="0.7"/>
            <Button DockPanel.Dock="Right" Content="Salvar" Width="120" Margin="8,0,0,0"
                    Style="{DynamicResource AccentButtonStyle}" Click="Save_Click"/>
            <Button DockPanel.Dock="Right" Content="Fechar" Width="120" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
