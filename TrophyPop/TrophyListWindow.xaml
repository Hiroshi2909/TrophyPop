<Window x:Class="TrophyPop.TrophyListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrophyPop"
        Title="Troféus" Width="1120" Height="740" MinWidth="880" MinHeight="520"
        WindowStartupLocation="CenterScreen" ThemeMode="Dark"
        Background="#080B16" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#15234A" Offset="0"/>
                <GradientStop Color="#090D1B" Offset="0.55"/>
                <GradientStop Color="#05070E" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Jogos -->
        <Border Background="#40000000" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,20,8,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Path Data="{x:Static local:TrophyArt.Geometry}" Fill="{x:Static local:TrophyArt.GoldBrush}"
                          Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="Troféus" FontSize="26" FontWeight="SemiBold" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ProfileText" DockPanel.Dock="Top" Opacity="0.6" Margin="0,2,0,14"/>
                <Grid DockPanel.Dock="Top" Margin="0,0,10,10">
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Buscar jogo" IsHitTestVisible="False" Opacity="0.45"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="GamesStatus" DockPanel.Dock="Top" Opacity="0.6" FontSize="12" Margin="2,0,10,8" TextWrapping="Wrap"/>
                <ListBox x:Name="GamesList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="GamesList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="6" Background="#22FFFFFF"/>
                                <Border Width="36" Height="36" CornerRadius="6">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Opacity="0.55"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Troféus do jogo escolhido -->
        <Grid Grid.Column="1" Margin="30,24,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="GameHeader" Visibility="Collapsed" Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="230" Height="108" CornerRadius="10" Background="#22FFFFFF"/>
                <Border x:Name="HeaderImage" Width="230" Height="108" CornerRadius="10"/>
                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="GameTitle" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Grid Margin="0,12,0,0" Width="420" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="Progress" Maximum="100" Height="6" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ProgressText" Grid.Column="1" Margin="12,0,0,0" FontWeight="SemiBold"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <StackPanel x:Name="CountsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <Button x:Name="PlatinumClipButton" Content="▶ Ver clipe da Platina" Visibility="Collapsed"
                                Margin="6,0,0,0" Padding="12,4" FontSize="12.5" Click="PlatinumClip_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <DockPanel x:Name="Toolbar" Grid.Row="1" Margin="0,22,10,12" Visibility="Collapsed">
                <ComboBox x:Name="FilterBox" Width="200" SelectionChanged="View_Changed">
                    <ComboBoxItem Content="Todos os troféus"/>
                    <ComboBoxItem Content="Conquistados"/>
                    <ComboBoxItem Content="Não conquistados"/>
                </ComboBox>
                <ComboBox x:Name="SortBox" Width="200" Margin="10,0,0,0" SelectionChanged="View_Changed">
                    <ComboBoxItem Content="Ordem padrão"/>
                    <ComboBoxItem Content="Mais recentes"/>
                    <ComboBoxItem Content="Mais raros"/>
                    <ComboBoxItem Content="Mais comuns"/>
                </ComboBox>
                <Button Content="Pasta de capturas" Margin="10,0,0,0" Padding="12,4" Click="OpenCaptures_Click"/>
                <TextBlock x:Name="ListInfo" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.55"/>
            </DockPanel>

            <ItemsControl x:Name="AchList" Grid.Row="2"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Focusable="False" CanContentScroll="True" PanningMode="VerticalOnly">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,10,8" Padding="12" CornerRadius="10"
                                Background="#12FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="175"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="8" Background="#22FFFFFF"/>
                                <Border Width="56" Height="56" CornerRadius="8" Opacity="{Binding IconOpacity}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" Opacity="{Binding TextOpacity}">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12.5" Opacity="0.72" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding UnlockText}" FontSize="11.5" Foreground="{Binding UnlockBrush}" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Path Data="{Binding GradeGeometry}" Fill="{Binding GradeBrush}"
                                              Width="20" Height="20" Stretch="Uniform"/>
                                        <TextBlock Text="{Binding GradeText}" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RarityText}" FontSize="11.5" Opacity="0.55" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                    <Button Content="Ver print" Visibility="{Binding ScreenshotVisibility}"
                                            HorizontalAlignment="Right" Margin="0,6,0,0" Padding="10,2" FontSize="11.5"
                                            Tag="{Binding}" Click="ViewScreenshot_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="DetailStatus" Grid.RowSpan="3" Text="Escolha um jogo na lista"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" FontSize="15"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440"/>
        </Grid>
    </Grid>
</Window>
